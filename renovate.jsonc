{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // The aqua preset is pinned rather than floating: it owns which files the aqua
  // manager reads, and a preset-side change would silently re-scope this repo.
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>aquaproj/aqua-renovate-config#2.13.0"
  ],

  "minimumReleaseAge": "3 days",

  // npm's resolution-time cooldown (min-release-age in .npmrc) needs this floor,
  // otherwise the flag is ignored and lockFileMaintenance pulls same-day releases.
  "constraints": {
    "npm": ">=11.10.0"
  },

  // Use the OSV database on top of GitHub's advisories — it is what surfaces the
  // transitive alerts in package-lock.json that GitHub is slow to report.
  "osvVulnerabilityAlerts": true,

  "vulnerabilityAlerts": {
    "description": [
      "Security updates get a shorter soak, not none.",
      "Waiting the full 3 days on a known CVE is its own risk, but merging a release",
      "published minutes ago — unattended, straight into the cluster — is exactly the",
      "case the age gate exists for: a poisoned release is least likely to have been",
      "noticed while it is brand new. Most advisory fix versions are already older",
      "than this by the time the advisory lands, so in practice this delays almost",
      "nothing."
    ],
    "minimumReleaseAge": "1 day",
    "schedule": ["at any time"],
    "labels": ["security"]
  },

  "lockFileMaintenance": {
    "description": [
      "Every open alert here is a transitive dependency in package-lock.json, which",
      "no direct-dependency bump reaches. The refresh is age-gated at resolution",
      "time by min-release-age in .npmrc, and the build job installs from the",
      "refreshed lock file and compiles against it."
    ],
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  },

  // Merge directly rather than queueing on GitHub: this repo has no required checks
  // that platform automerge would wait on, and queueing just delays the merge.
  "platformAutomerge": false,

  "customManagers": [
    {
      "description": [
        "zizmor's version input, pinned so the action resolves a digest-pinned",
        "container instead of `latest`. Every other CLI in the workflows comes from",
        "aqua.yaml now, which the aqua preset handles. extractVersionTemplate drops",
        "the tag's leading v to match how the version is written in the file."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[\\w-]+: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],

  "packageRules": [
    {
      // Pin every docker reference to a digest. Written as a packageRule rather than
      // a top-level `docker` block, which is the pre-migration spelling.
      "description": "Pin docker digests; the digest-cooldown workflow soaks them before merge",
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Automerge patch/minor and digests (gated by digest-cooldown for docker)",
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true
    }
  ]
}
