# Refuse to resolve any version published less than 3 days ago (npm >= 11.10.0,
# value in days). Renovate's own minimumReleaseAge cannot cover a lock-file
# refresh — there is no single release to date, every transitive dependency
# just jumps to whatever satisfies the range — so the cooldown has to be
# enforced here, at resolution time, where it applies to every package in the
# tree. Use min-release-age-exclude for a package that genuinely needs to skip
# it.
min-release-age=3
